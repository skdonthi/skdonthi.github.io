# Cloudflare Workers static assets headers. Personal site: no indexing, no AI training.
# CSS/JS carry a version query string in the HTML; no long cache on them here.
/*
  X-Robots-Tag: noindex, nofollow, noarchive, noimageindex, noai, noimageai
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

/assets/*
  Cache-Control: public, max-age=3600
